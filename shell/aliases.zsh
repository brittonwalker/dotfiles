# Navigation
alias ..="cd .."
alias ...="cd ../.."

alias proj="cd ~/Projects"
alias dev="cd ~/Development"
alias dots="cd ~/dotfiles"

# Git
alias gs="git status"
alias ga="git add ."
alias gc="git commit -m"
alias gp="git push"

# General
alias ls="eza"
alias ll="eza -la --git"
alias tree="eza --tree --git-ignore"

alias reload="source ~/.zshrc"
alias path='echo "$PATH" | tr ":" "\n"'